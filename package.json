{
  "name": "studytime",
  "productName": "StudyTime",
  "version": "1.0.0",
  "description": "A gamified history study app for AP World History and AP US History.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.2.8",
    "@fontsource/nunito": "^5.2.6",
    "kokoro-js": "^1.2.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "38.1.2",
    "electron-builder": "26.0.12",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  },
  "build": {
    "appId": "com.jude.studytime",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
